import { render, screen, waitFor } from "@testing-library/react";
import userEvent from "@testing-library/user-event";
import { describe, it, expect, beforeEach, vi } from "vitest";
import { BrowserRouter } from "react-router-dom";
import Auth from "../auth/page";

// Mock do localStorage
const localStorageMock = (() => {
  let store = {};
  return {
    getItem: (key) => store[key] || null,
    setItem: (key, value) => {
      store[key] = value.toString();
    },
    removeItem: (key) => {
      delete store[key];
    },
    clear: () => {
      store = {};
    },
  };
})();

Object.defineProperty(window, "localStorage", {
  value: localStorageMock,
});

const AuthWithRouter = () => (
  <BrowserRouter>
    <Auth />
  </BrowserRouter>
);

describe("Auth Page", () => {
  beforeEach(() => {
    localStorage.clear();
    vi.clearAllMocks();
  });

  it("should render login form initially", () => {
    render(<AuthWithRouter />);

    expect(screen.getByText("Login")).toBeInTheDocument();
    expect(screen.getByLabelText("Email")).toBeInTheDocument();
    expect(screen.getByLabelText("Password")).toBeInTheDocument();
  });

  it("should switch to signup form when button is clicked", async () => {
    const user = userEvent.setup();
    render(<AuthWithRouter />);

    const switchButton = screen.getByText(/don't you have an account/i);
    await user.click(switchButton);

    await waitFor(() => {
      expect(screen.getByText("Signup")).toBeInTheDocument();
      expect(screen.getByLabelText("Fullname")).toBeInTheDocument();
    });
  });

  it("should allow user to type in email field", async () => {
    const user = userEvent.setup();
    render(<AuthWithRouter />);

    const emailInput = screen.getByLabelText("Email");
    await user.type(emailInput, "test@example.com");

    expect(emailInput.value).toBe("test@example.com");
  });

  it("should allow user to type in password field", async () => {
    const user = userEvent.setup();
    render(<AuthWithRouter />);

    const passwordInput = screen.getByLabelText("Password");
    await user.type(passwordInput, "password123");

    expect(passwordInput.value).toBe("password123");
  });

  it("should validate password confirmation on signup", async () => {
    const user = userEvent.setup();
    render(<AuthWithRouter />);

    // Switch to signup
    const switchButton = screen.getByText(/don't you have an account/i);
    await user.click(switchButton);

    // Fill form with mismatched passwords
    await waitFor(() => {
      expect(screen.getByLabelText("Fullname")).toBeInTheDocument();
    });

    const fullnameInput = screen.getByLabelText("Fullname");
    const emailInput = screen.getByLabelText("Email");
    const passwordInputs = screen.getAllByLabelText("Password");
    const confirmPasswordInput = screen.getByLabelText("ConfirmPassword");

    await user.type(fullnameInput, "João Silva");
    await user.type(emailInput, "joao@example.com");
    await user.type(passwordInputs[0], "password123");
    await user.type(confirmPasswordInput, "password456");

    const submitButton = screen.getByRole("button", { name: /signup/i });
    await user.click(submitButton);

    // Verificar que o console.log foi chamado
    await waitFor(() => {
      expect(screen.getByText("Signup")).toBeInTheDocument();
    });
  });
});
